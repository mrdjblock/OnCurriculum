<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.3-c011 66.145661, 2012/02/06-14:56:27        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Graph_1new</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A circular graphic depicts the experiential learning cycle. In the centre is a circle labelled Student, linking three overlapping circles labelled Participate, Reflect, and Apply. Double-headed arrows between the three circles indicate the fluid relationship between them. An outer band encircling the inner circles contain the words Local, National, and Global along the top, and On-site, Blended, and Virtual along the bottom, signalling the possible options related to community-connected experiential learning.</rdf:li>
            </rdf:Alt>
         </dc:description>
      </rdf:Description>
